{
  "$comment": "LagScope design tokens (direction A, 'Pulse line'; design/DESIGN.md). Pulse generates its Tailwind theme from this file; the app its egui look. Change here, then adopt in both.",
  "color": {
    "ground": "#0A0C0F",
    "surface": "#11151A",
    "line": "#222A33",
    "rule": "#1C232B",
    "raised": "#161B21",
    "raised-line": "#2A333D",
    "text": "#EAF0F5",
    "soft": "#B4BEC8",
    "muted": "#93A0AD",
    "mint": "#5BE7C4",
    "mint-hi": "#9AF3DC",
    "mint-ink": "#06261D",
    "mint-bg": "#0F2A21",
    "orange": "#FF8A3D",
    "orange-soft": "#FFB27A",
    "orange-bg": "#2A1A0E",
    "gray-chip": "#1E242C",
    "gray-chip-text": "#C9D2DB",
    "soon": "#1A2028",
    "yellow": "#F5D76E",
    "verdict-warn-bg": "#15120F",
    "verdict-warn-line": "#3A2A1E",
    "verdict-ok-bg": "#0E1613",
    "verdict-ok-line": "#1E3A30",
    "device": "#3A4450"
  },
  "font": {
    "display": "Space Grotesk",
    "text": "Inter",
    "mono": "JetBrains Mono",
    "$license": "All three: SIL Open Font License 1.1; embed or self-host, never load from Google"
  },
  "radius": { "card": 20, "card-phone": 18, "button": 999, "chip": 999 },
  "size": { "touch-target": 44 },
  "status": {
    "ok": { "color": "mint", "shape": "circle", "word": "fine" },
    "warn": { "color": "orange", "shape": "square", "word": "worth a look" },
    "na": { "color": "device", "shape": "square", "word": "not measured" }
  },
  "chart": {
    "line": "mint",
    "freeze": "orange",
    "device-pause": "device",
    "beat-grid": { "color": "orange", "opacity": 0.35, "dash": [4, 6] }
  }
}
